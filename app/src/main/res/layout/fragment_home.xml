<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:background="#F8F9FA"
    tools:context=".view.HomeFragment">

    <TextView
        android:id="@+id/welcoming_txt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Halo, Zap!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A1C1E"
        android:letterSpacing="-0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/ask_txt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Apa kabarmu hari ini?"
        android:textSize="16sp"
        android:textColor="#5C6066"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@id/welcoming_txt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcoming_txt"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/ask_txt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="20dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Run"
                    android:textColor="#8E9199"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:layout_marginTop="4dp"
                    android:textColor="#1A1C1E"/>
            </LinearLayout>

            <View
                android:layout_width="1.5dp"
                android:layout_height="32dp"
                android:background="#F1F1F1"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Hari Ini"
                    android:textColor="#8E9199"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 KM"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/biru"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_run_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        tools:listitem="@layout/item_run"
        app:layout_constraintTop_toBottomOf="@id/card_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/floating_btn_add_run"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Tambah"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/biru"
        app:icon="@drawable/ic_add"
        app:iconTint="@android:color/white"
        app:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>